#000000;strokeWidth=1;" edge="1" parent="1" source="n152" target="n163"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="920"/><mxPoint x="730" y="1009"/></Array></mxGeometry></mxCell><mxCell id="n165" value="Register map (byte addr): 0x00 CTRL {irq, mode, en}, 0x04 COMPARE, 0x08 COUNTER (read only). we_com ignores wstrb; we_ctrl needs wstrb[0]." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="330" height="64" as="geometry"/></mxCell><mxCell id="n166" value="Mode: 0 = periodic (counter clears to 0), 1 = one-shot (timer_en_q cleared). timer_en_q: halt pulse overrides a software write." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="330" height="52" as="geometry"/></mxCell><mxCell id="n167" value="IRQ: action_pulse has priority over timer_irq_clear. wdata[2] clears the interrupt. All banks: clk_i, async active-low rst_ni." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="330" height="52" as="geometry"/></mxCell><mxCell id="n168" value="Response: rsp.ready = 1, rsp.valid = req.valid, err = 0. Read data is combinational." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1420" y="650" width="300" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>