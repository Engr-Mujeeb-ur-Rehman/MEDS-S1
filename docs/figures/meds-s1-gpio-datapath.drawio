="1" as="geometry"></mxGeometry></mxCell><mxCell id="e118" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=4;jettySize=auto;orthogonalLoop=1;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0.5;entryY=1;entryPerimeter=0;strokeColor=#0000FF;strokeWidth=1;" edge="1" parent="1" source="n112" target="n111"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="930" y="783"/></Array></mxGeometry></mxCell><mxCell id="e119" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;endSize=4;jettySize=auto;orthogonalLoop=1;fontSize=8;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitPerimeter=0;entryX=0;entryY=0.5;entryPerimeter=0;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1" source="n111" target="n113"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n120" value="Write enable (we_*) drives the MUX select, so each D-FF bank behaves as a flip-flop with enable. All banks: clk_i, async active-low rst_ni." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="300" height="62" as="geometry"/></mxCell><mxCell id="n121" value="Edge detector: XOR(syn2_q, delay_q) pulses on rising AND falling edges. No debounce." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="640" y="505" width="250" height="36" as="geometry"/></mxCell><mxCell id="n122" value="IRQ priority: next_irq = (irq &amp; ~clear) | edge, a new edge wins over a simultaneous W1C clear." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1130" y="210" width="300" height="40" as="geometry"/></mxCell><mxCell id="n123" value="Response: rsp.ready = 1, rsp.valid = req.valid, err = 0, read data is combinational. AXI-Lite handshakes are owned by meds_s1_lite_axi_adapter." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1040" y="710" width="300" height="50" as="geometry"/></mxCell><mxCell id="n124" value="Register map (byte addr): 0x00 DIR, 0x04 DATA (R: syn2_q / W: dout), 0x08 IRQ status / W1C" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=5;fontSize=9;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="300" height="50" as="geometry"/></mxCell><mxCell id="n125" value="ADDRESS DECODE + WRITE ENABLES" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="190" y="20" width="260" height="20" as="geometry"/></mxCell><mxCell id="n126" value="INPUT SYNCHRONISER / EDGE DETECT" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="640" y="400" width="300" height="20" as="geometry"/></mxCell><mxCell id="n127" value="READ MUX" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="720" y="585" width="200" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>