`verilator_config
// Copyright 2026 Maktab-e-Digital Systems Lahore.
// SPDX-License-Identifier: Apache-2.0
//
// Lint waivers for MEDS-S1.
//
// ALL waivers live in this file and ALL of them carry a justification --
// CODING_STANDARD.md R-L2.  A waiver without a reason is a review blocker, not
// a style preference.
//
// Two gotchas when editing this file:
//   * `verilator_config must be the very first line.
//   * A comment must not begin with the tool's own name, or it is parsed as a
//     metacomment and becomes a syntax error.

// s1_pkg is a package of shared constants and types.  Any single module uses a
// subset of it; that is the point of a shared package, not a defect.
lint_off -rule UNUSEDPARAM -file "*s1_pkg.sv"

// Testbenches legitimately declare signals that only some test paths drive, and
// deliberately mix widths when building corner-case stimulus.
lint_off -rule UNUSEDSIGNAL -file "*verif/unit/*"
lint_off -rule WIDTHTRUNC   -file "*verif/unit/*"
lint_off -rule WIDTHEXPAND  -file "*verif/unit/*"
lint_off -rule DECLFILENAME -file "*verif/*"

// `make lint` checks the whole RTL tree as a library, so there is deliberately
// no single top module.  Once the generator emits meds_s1_soc_top (R-04), the
// lint target gains --top-module and this waiver should be REMOVED.
lint_off -rule MULTITOP
